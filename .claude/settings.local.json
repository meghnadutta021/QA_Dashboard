{
  "permissions": {
    "allow": [
      "Bash(curl -s -w \"\\\\n%{http_code}\" http://localhost:8080/overview)",
      "Bash(curl -s -w \"\\\\n%{http_code}\" http://localhost:8080/dashboard)",
      "Bash(curl -s http://localhost:8080/)",
      "Bash(curl -s --max-time 10 \"http://localhost:8080/\")",
      "Bash(curl -s --no-keepalive \"http://localhost:8080/\")",
      "Bash(lsof -ti:8080)",
      "Bash(curl -s --compressed \"http://localhost:8080/\")",
      "Bash(wget -q -O /tmp/dash.html \"http://localhost:8080/\")",
      "Bash(python3 *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "appium-mcp"
  ]
}
